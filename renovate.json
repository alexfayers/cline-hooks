{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardLabels": ["dependency-dashboard"],
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "minimumReleaseAge": "3 days",
  "groupSingleUpdates": true,
  "prConcurrentLimit": 4,
  "automerge": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchManagers": [
        "!github-actions"
      ],
      "groupSlug": "major-updates",
      "addLabels": [
        "needs-review"
      ]
    }
  ]
}
